{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run BOT",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/src/index.js"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
        "label": "Deploy Commands",
        "type": "shell",
        "command": "node",
        "args": ["${workspaceFolder}/src/deploy-commands.js"],
        "group": {
            "kind": "build",
            "isDefault": false
        },
        "presentation": {
            "reveal": "always",
            "panel": "shared"
        }
    }
  ]
}